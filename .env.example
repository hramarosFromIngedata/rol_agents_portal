# Used by docker-compose.yaml (both for its own ${APP_PORT} substitution and
# as env_file for the container). Copy to `.env` on the deploy server and
# fill in real values — do NOT commit `.env` to version control.

# Host port docker-compose binds to (127.0.0.1 only, see docker-compose.yaml).
# Pick something free on the target server to avoid clashing with other
# containers/services already running there — check first with:
#   ss -ltnp | grep <port>
#   docker ps --format "{{.Names}} {{.Ports}}"
APP_PORT=3100

N8N_API_KEY=
N8N_HOST=

# Optional: override individual n8n webhook paths (mounted under ${N8N_HOST}/webhook/)
# without touching code. Defaults shown below (lib/webhooks.ts).
# N8N_WEBHOOK_ROL_PORTAL=rol-portal
# N8N_WEBHOOK_MISTRAL_PRICE=mistral-price
# N8N_WEBHOOK_OPENROUTER_PRICE=openrouter-price
# N8N_WEBHOOK_ROL_STORE_META_DATA=rol-store-meta-data
# N8N_WEBHOOK_FETCH_FORM_DATA=fetch-form-data
